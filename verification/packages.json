      "allowedPaths": [
        "supabase/migrations/**",
        "supabase/tests/**"
      ],
      "appendOnlyPaths": [
        "supabase/migrations/**"
      ],
      "expectPgtapDeltaMin": 5,
      "frozenFiles": {}
    },
